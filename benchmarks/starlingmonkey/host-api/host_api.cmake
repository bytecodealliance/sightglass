# A StarlingMonkey host API for sightglass, selected by setting the `HOST_API`
# environment variable to this directory. `bindings/` is generated by
# `wit-bindgen c` from `wit/` (see the Dockerfile).

add_library(host_api STATIC
        ${HOST_API}/host_api.cpp
        ${HOST_API}/bindings/benchmark.c
        ${HOST_API}/bindings/benchmark_component_type.o
)

target_link_libraries(host_api PRIVATE spidermonkey)
target_include_directories(host_api PRIVATE
        ${CMAKE_CURRENT_SOURCE_DIR}/include
        ${HOST_API}/bindings)

set(ADAPTER "${CMAKE_CURRENT_SOURCE_DIR}/host-apis/wasi-0.2.0/preview1-adapter-release/wasi_snapshot_preview1.wasm")
